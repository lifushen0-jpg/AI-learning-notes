   "source": [
    "# 向量范数——欧几里得范数L2\n",
    "u = torch.tensor([3.0,-4.0])\n",
    "print(torch.norm(u))\n",
    "\n",
    "# L1范数\n",
    "torch.abs(u).sum()\n"
   ]
